# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/legendariumdb"

# Secret key for signing session cookies (min 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# Yandex SpeechKit API key (https://cloud.yandex.ru/docs/iam/concepts/authorization/api-key)
# If not set, the TTS player will not appear on material pages.
YANDEX_TTS_API_KEY=""
