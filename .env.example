# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/legendariumdb"

# Secret key for signing session cookies (min 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-32-char-secret"

# Public base URL of the app (used in emails, sitemap, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Text-to-speech (optional, at most one is required) ---

# ElevenLabs (https://elevenlabs.io/) — preferred, more natural Russian voices.
# If set, takes priority over Yandex SpeechKit below.
ELEVENLABS_API_KEY=""
# Optional: override the default voice ID
ELEVENLABS_VOICE_ID=""

# Yandex SpeechKit API key (https://cloud.yandex.ru/docs/iam/concepts/authorization/api-key)
# Used as a fallback if ELEVENLABS_API_KEY is not set.
# If neither is set, the TTS player will not appear on material pages.
YANDEX_TTS_API_KEY=""

# --- Email (optional) ---

# Resend API key (https://resend.com/) — used for password reset emails.
# If not set, password reset requests will fail to send an email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@legendarium.ru"

