# Пример конфигурации nginx как reverse proxy перед Next.js (порт 3000).
# Скопируйте на сервер в /etc/nginx/sites-available/legendarium,
# подставьте свой домен и подключите через симлинк в sites-enabled.
#
#   sudo ln -s /etc/nginx/sites-available/legendarium /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# После этого выпустите HTTPS-сертификат командой:
#   sudo certbot --nginx -d your-domain.ru -d www.your-domain.ru

server {
    listen 80;
    server_name your-domain.ru www.your-domain.ru;

    client_max_body_size 15m;  # запас под загрузку медиафайлов (лимит сервера — 10mb)

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
